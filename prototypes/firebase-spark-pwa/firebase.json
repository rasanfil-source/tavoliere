{
  "hosting": {
    "site": "tavola-comune",
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "/assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "/build-manifest.json",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "Permissions-Policy",
            "value": "camera=(), microphone=(), geolocation=()"
          },
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          },
          {
            "key": "Cross-Origin-Opener-Policy",
            "value": "same-origin-allow-popups"
          }
        ]
      },
      {
        "source": "/index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, max-age=0, must-revalidate"
          }
        ]
      },
      {
        "source": "/sw.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/manifest.webmanifest",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/manifest+json; charset=utf-8"
          }
        ]
      },
      {
        "source": "/manifest-kitchen.webmanifest",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/manifest+json; charset=utf-8"
          }
        ]
      }
    ],
    "redirects": [
      {
        "source": "/icons/launcher-192.png",
        "destination": "/icons/app-icon-any-192-v2.png",
        "type": 302
      },
      {
        "source": "/icons/launcher-512.png",
        "destination": "/icons/app-icon-any-512-v2.png",
        "type": 302
      },
      {
        "source": "/icons/launcher-192-maskable.png",
        "destination": "/icons/app-icon-maskable-192-v2.png",
        "type": 302
      },
      {
        "source": "/icons/launcher-512-maskable.png",
        "destination": "/icons/app-icon-maskable-512-v2.png",
        "type": 302
      },
      {
        "source": "/icons/splash-512-transparent.png",
        "destination": "/icons/app-icon-any-512-v2.png",
        "type": 302
      },
      {
        "source": "/icons/splash-512-blended.png",
        "destination": "/icons/app-icon-any-512-v2.png",
        "type": 302
      },
      {
        "source": "/icons/icon-192.png",
        "destination": "/icons/app-icon-any-192-v2.png",
        "type": 302
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "emulators": {
    "firestore": {
      "host": "127.0.0.1",
      "port": 8085
    }
  }
}
